# EditorConfig settings for mozc-builder
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps{1,m1,d1}]
end_of_line = crlf
indent_size = 2

[*.sh]
end_of_line = lf
indent_size = 2

[*.{json,yaml,yml,toml}]
indent_size = 2

[Makefile]
indent_style = tab
